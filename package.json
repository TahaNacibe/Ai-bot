{
  "name": "local-ai-desktop",
  "private": true,
  "version": "1.0.0",
  "main": "dist-electron/main.js",
  "description": "Desktop shell for the local AI chat app with embedded Python server",
  "author": "AI Tube",
  "scripts": {
    "dev": "cross-env NODE_ENV=development vite",
    "build": "vite build",
    "desktop:dev": "cross-env NODE_ENV=development vite",
    "desktop:build": "cross-env NODE_ENV=production vite build && cross-env NODE_ENV=production electron-builder",
    "renderer:build": "vite build"
  },
  "build": {
    "appId": "com.ai-tube.local-ai",
    "productName": "Local AI Chat",
    "asar": true,
    "directories": {
      "output": "dist"
    },
    "files": [
      "dist-electron/**/*",
      "dist-vite/**/*",
      "electron/**/*"
    ],
    "extraResources": [
      {
        "from": "server.py",
        "to": "server.py"
      },
      {
        "from": "core.py",
        "to": "core.py"
      },
      {
        "from": "config",
        "to": "config"
      },
      {
        "from": "repository",
        "to": "repository"
      },
      {
        "from": "settings",
        "to": "settings"
      },
      {
        "from": "plugins/web",
        "to": "plugins/web"
      },
      {
        "from": "personas",
        "to": "personas"
      },
      {
        "from": "requirements.txt",
        "to": "requirements.txt"
      },
      {
        "from": "model_requirements.txt",
        "to": "model_requirements.txt"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "./assets/icon.ico"
    }
  },
  "dependencies": {
    "i18next": "^26.5.4",
    "next-themes": "^0.4.6",
    "react-i18next": "^17.1.0",
    "react-router-dom": "^7.18.4",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@fontsource-variable/geist": "^5.2.8",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cross-env": "^10.0.0",
    "electron": "^41.0.3",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.27.4",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "lucide-react": "^1.7.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.1",
    "vite-plugin-electron": "^0.29.1",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
